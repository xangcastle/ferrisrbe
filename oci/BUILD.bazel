load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")

IMAGE_REPO = "docker.io/xangcastle/ferris-"

genrule(
    name = "timestamp_file",
    outs = ["timestamp.txt"],
    cmd = "bash $(location process_timestamp.sh) $@",
    stamp = 1,
    tools = ["process_timestamp.sh"],
)

genrule(
    name = "image_tags",
    outs = ["tags.txt"],
    cmd = "bash $(location process_tags.sh) $@",
    stamp = 1,
    tools = ["process_tags.sh"],
)

platform_transition_filegroup(
    name = "server.amd64",
    srcs = ["//:server"],
    target_platform = "//platforms:linux_amd64",
)

tar(
    name = "server.amd64.layer",
    srcs = [":server.amd64"],
    mtree = [
        "./app/server type=file content=$(execpath :server.amd64)",
    ],
)

oci_image(
    name = "server.amd64.image",
    base = "@debian_bookworm_slim_linux_amd64",
    created = ":timestamp_file",
    entrypoint = ["/app/server"],
    exposed_ports = [
        "9094",
        "8080",
    ],
    tars = [":server.amd64.layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server.amd64.image.load",
    image = ":server.amd64.image",
    repo_tags = ["ferrisrbe/server:latest"],
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "server.arm64",
    srcs = ["//:server"],
    target_platform = "//platforms:linux_arm64",
)

tar(
    name = "server.arm64.layer",
    srcs = [":server.arm64"],
    mtree = [
        "./app/server type=file content=$(execpath :server.arm64)",
    ],
)

oci_image(
    name = "server.arm64.image",
    base = "@debian_bookworm_slim_linux_arm64_v8",
    created = ":timestamp_file",
    entrypoint = ["/app/server"],
    exposed_ports = [
        "9094",
        "8080",
    ],
    tars = [":server.arm64.layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server.arm64.image.load",
    image = ":server.arm64.image",
    repo_tags = ["ferrisrbe/server:latest"],
    visibility = ["//visibility:public"],
)

oci_image_index(
    name = "server.image.multiplatform",
    images = [
        ":server.amd64.image",
        ":server.arm64.image",
    ],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "server.image.push",
    image = ":server.image.multiplatform",
    remote_tags = ":image_tags",
    repository = IMAGE_REPO + "server",
    visibility = ["//visibility:public"],
)

oci_push(
    name = "server.image.arm64.push",
    image = ":server.arm64.image",
    remote_tags = ":image_tags",
    repository = IMAGE_REPO + "server",
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "worker.amd64",
    srcs = ["//:worker"],
    target_platform = "//platforms:linux_amd64",
)

tar(
    name = "worker.amd64.layer",
    srcs = [":worker.amd64"],
    mtree = [
        "./app/worker type=file content=$(execpath :worker.amd64)",
    ],
)

oci_image(
    name = "worker.amd64.image",
    base = "@debian_bookworm_slim_linux_amd64",
    created = ":timestamp_file",
    entrypoint = ["/app/worker"],
    env = {
        "RUST_LOG": "info",
        "WORKER_ID": "",
        "SERVER_ENDPOINT": "http://server:9094",
        "CAS_ENDPOINT": "http://server:9094",
        "WORKER_TYPE": "default",
        "WORKER_LABELS": "os=linux,arch=amd64",
        "MAX_CONCURRENT": "4",
        "WORKDIR": "/workspace",
    },
    tars = [":worker.amd64.layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "worker.amd64.image.load",
    image = ":worker.amd64.image",
    repo_tags = ["ferrisrbe/worker:latest"],
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "worker.arm64",
    srcs = ["//:worker"],
    target_platform = "//platforms:linux_arm64",
    visibility = ["//local:__pkg__"],
)

tar(
    name = "worker.arm64.layer",
    srcs = [":worker.arm64"],
    mtree = [
        "./app/worker type=file content=$(execpath :worker.arm64)",
    ],
)

oci_image(
    name = "worker.arm64.image",
    base = "@debian_bookworm_slim_linux_arm64_v8",
    created = ":timestamp_file",
    entrypoint = ["/app/worker"],
    env = {
        "RUST_LOG": "info",
        "WORKER_ID": "",
        "SERVER_ENDPOINT": "http://server:9094",
        "CAS_ENDPOINT": "http://server:9094",
        "WORKER_TYPE": "default",
        "WORKER_LABELS": "os=linux,arch=arm64",
        "MAX_CONCURRENT": "4",
        "WORKDIR": "/workspace",
    },
    tars = [":worker.arm64.layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "worker.arm64.image.load",
    image = ":worker.arm64.image",
    repo_tags = ["ferrisrbe/worker:latest"],
    visibility = ["//visibility:public"],
)

oci_image_index(
    name = "worker.image.multiplatform",
    images = [
        ":worker.amd64.image",
        ":worker.arm64.image",
    ],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "worker.image.push",
    image = ":worker.image.multiplatform",
    remote_tags = ":image_tags",
    repository = IMAGE_REPO + "worker",
    visibility = ["//visibility:public"],
)

oci_push(
    name = "worker.image.arm64.push",
    image = ":worker.arm64.image",
    remote_tags = ":image_tags",
    repository = IMAGE_REPO + "worker",
    visibility = ["//visibility:public"],
)
