#!/usr/bin/env bash
# Bazel credential helper for the FerrisRBE gRPC endpoint (--credential_helper).
# CI presents the static RBE_CI_TOKEN; a laptop delegates to `rbe-cli
# credential-helper get` after `rbe-cli install`; otherwise no credential is
# sent, which the server accepts while RBE_GRPC_AUTH_ENABLED is off.
set -euo pipefail

if [[ "${1:-}" != "get" ]]; then
  echo "usage: $0 get" >&2
  exit 2
fi

if [[ -n "${RBE_CI_TOKEN:-}" ]]; then
  cat >/dev/null
  case "$RBE_CI_TOKEN" in
    *'"'* | *'\'*)
      echo "RBE_CI_TOKEN cannot be embedded in JSON" >&2
      exit 1
      ;;
  esac
  printf '{"headers":{"Authorization":["Bearer %s"]}}\n' "$RBE_CI_TOKEN"
  exit 0
fi

rbe_cli="${HOME}/.rbe/bin/rbe-cli"
if [[ -x "$rbe_cli" ]]; then
  exec "$rbe_cli" credential-helper get
fi

cat >/dev/null
echo '{}'
